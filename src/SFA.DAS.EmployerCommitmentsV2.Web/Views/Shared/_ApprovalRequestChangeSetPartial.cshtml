@using SFA.DAS.CommitmentsV2.Shared.Extensions
@using SFA.DAS.EmployerCommitmentsV2.Web.Extensions

@model ICollection<SFA.DAS.EmployerCommitmentsV2.Web.Models.Apprentice.ApprovalFieldRequestAlertViewModel>

<table class="govuk-table das-table--condensed das-table--responsive das-table--double-arrows">
    <thead class="govuk-table__head">
        <tr class="govuk-table__row">
            <th scope="col" class="govuk-table__header">
                Date of change
            </th>
            <th scope="col" class="govuk-table__header">
                Change made
            </th>
            <th scope="col" class="govuk-table__header">
                Previous
            </th>
            <th scope="col" class="govuk-table__header">
                Current
            </th>
            <th scope="col" class="govuk-table__header">
                Decision
            </th>
        </tr>
    </thead>
    <tbody class="govuk-table__body">
        @foreach (var approvalField in Model)
        {
            <tr class="govuk-table__row">

                <td class="govuk-table__cell" data-label="Date of change">
                    @approvalField.Created.ToGdsFormat()

                </td>
                <td class="govuk-table__cell" data-label="Change made">
                    @approvalField.Field
                </td>
                <td class="govuk-table__cell" data-label="Previous">
                    @approvalField.Old
                </td>
                <td class="govuk-table__cell" data-label="Current">
                    @approvalField.New
                </td>
                <td class="govuk-table__cell " data-label="Decision">

                    <strong class="govuk-tag govuk-tag--grey">@approvalField.Status.GetEnumDescription()</strong>

                </td>
            </tr>
        }
    </tbody>
</table>
