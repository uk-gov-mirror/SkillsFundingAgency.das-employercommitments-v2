@using SFA.DAS.CommitmentsV2.Shared.Extensions
@model SFA.DAS.EmployerCommitmentsV2.Web.Models.Apprentice.ApprovalRequestAlertViewModel

<div class="govuk-form-group @Html.AddClassIfPropertyInError(x => x.EmployerAcknowlededAt, "govuk-form-group--error")">
    <fieldset class="govuk-fieldset">
        <legend class="govuk-fieldset__legend govuk-fieldset__legend--m">
            <h2 class="govuk-fieldset__heading">
                Do you want to delete this alert?
            </h2>
        </legend>
        <div class="govuk-radios">
            @Html.ValidationMessageFor(m => m.EmployerAcknowlededAt, null, new { @class = "govuk-error-message", id = "error-message-" + Html.IdFor(m => m.EmployerAcknowlededAt) })
            <div class="govuk-radios__item">
                <input class="govuk-radios__input" id="DeleteAlert_'+@Model.Id+'" name="DeleteAlert" type="radio" value="true">
                <label class="govuk-label govuk-radios__label" for="DeleteAlert_'+@Model.Id+'">
                    Yes, delete this alert
                </label>
            </div>
            <div class="govuk-radios__item">
                <input class="govuk-radios__input" id="DeleteAlert-no_'+@Model.Id+'" name="DeleteAlert" type="radio" value="false">
                <label class="govuk-label govuk-radios__label" for="DeleteAlert-no_'+@Model.Id+'">
                    No, keep the alert
                </label>
            </div>
        </div>
    </fieldset>
</div>